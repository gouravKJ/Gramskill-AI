# ---------------------------------------------------------------------------
# GramSkill AI — environment template
# Copy to `.env.local` (and `.env` for Prisma) and fill in what you need.
# Demo mode needs NOTHING below: it runs entirely from the bundled dataset.
# ---------------------------------------------------------------------------

# demo | postgres   (postgres requires DATABASE_URL + `npm run setup`)
DATA_SOURCE=demo

# Session signing secret. REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string

# PostgreSQL connection (only needed when DATA_SOURCE=postgres)
# DATABASE_URL=postgresql://gramskill:gramskill@localhost:5432/gramskill?schema=public

# AI agent provider (optional). Without these the agent runs its deterministic
# rule-based planner + local tools, which is the default demo experience.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Python ML service (optional). Without it the TypeScript matcher is used.
# ML_SERVICE_URL=http://localhost:8000
